{
    "name": "mitoop/laravel-signature",
    "type": "library",
    "authors": [
        {
            "name": "mitoop",
            "email": "me@mitoop.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "archtechx/enums": "^1.1",
        "laravel/framework": "^11|^12|^13",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "description": "Sign and verify Laravel API requests and callbacks.",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mitoop\\LaravelSignature\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mitoop\\LaravelSignature\\ServiceProvider"
            ]
        }
    }
}
